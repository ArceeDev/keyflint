{
  "name": "keyflint-verify",
  "version": "1.1.0",
  "description": "Zero-dependency offline verifier and MCP tool gating for KeyFlint Ed25519 license tokens (Web Crypto API).",
  "license": "MIT",
  "author": "ArceeDev",
  "homepage": "https://keyflint.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArceeDev/keyflint.git",
    "directory": "sdks/js-verify"
  },
  "bugs": {
    "url": "https://github.com/ArceeDev/keyflint/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./mcp": {
      "import": {
        "types": "./dist/esm/mcp.d.ts",
        "default": "./dist/esm/mcp.js"
      },
      "require": {
        "types": "./dist/cjs/mcp.d.ts",
        "default": "./dist/cjs/mcp.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.4"
  },
  "keywords": [
    "ed25519",
    "keyflint",
    "license",
    "licensing",
    "mcp",
    "model-context-protocol",
    "offline",
    "webcrypto"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
