# KeyFlint Production Environment Variables
# Copy to .env and fill in real production secrets before running in production.

ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:////app/data/keyforge.db
LOG_LEVEL=INFO
TRUST_PROXY_HEADERS=true

# REQUIRED PRODUCTION SECRETS (Do not use dev defaults!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_unique_random_secret_at_least_32_bytes_long

# Generate Ed25519 keypair with:
# python -c "import secrets; from app.infrastructure.security.ed25519_signer import Ed25519Signer; priv=secrets.token_hex(32); s=Ed25519Signer(private_key_hex=priv); print('PRIV:'+priv); print('PUB:'+s.get_public_key_hex())"
ED25519_PRIVATE_KEY_HEX=replace_with_64_hex_private_key
ED25519_PUBLIC_KEY_HEX=

# Admin API Key for /issue, /revoke, /quota/replenish
ADMIN_API_KEY=replace_with_strong_random_admin_token

# Billing Providers (Stripe / LemonSqueezy)
BILLING_MODE=mock  # Set to "live" when ready for real charges
STRIPE_WEBHOOK_SECRET=whsec_your_real_stripe_webhook_secret
LEMONSQUEEZY_WEBHOOK_SECRET=your_real_lemonsqueezy_webhook_secret
STRIPE_SECRET_KEY=sk_live_your_real_stripe_api_key
LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/buy
PUBLIC_BASE_URL=https://licenses.yourdomain.com
